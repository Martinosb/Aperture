# Copy to .env and fill in. Never commit .env or service-account.json.

# ── Shared ────────────────────────────────────────────
DEVICE_ID=window-01

# ── apps/web (public — these ship to the browser) ─────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_DEVICE_ID=window-01

# ── apps/bridge (secret — never expose) ───────────────
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
SERIAL_PORT=              # blank = auto-discover
SERIAL_BAUD=9600
LOG_LEVEL=info

# ── Local emulator (no Firebase project needed) ───────
# `pnpm emulators` starts the Realtime Database and Auth emulators. With these
# two set, the bridge needs no service account and the PWA needs no real project.
# Leave both blank to talk to the real Firebase project instead.
#
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# NEXT_PUBLIC_FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
