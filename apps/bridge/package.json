{
  "name": "@aperture/bridge",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop bridge relaying state between the Arduino and Firebase Realtime Database",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aperture-bridge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@aperture/shared": "workspace:*",
    "@serialport/parser-readline": "^13.0.0",
    "commander": "^14.0.1",
    "dotenv": "^17.2.3",
    "firebase-admin": "^13.6.0",
    "pino": "^10.0.0",
    "pino-pretty": "^13.1.2",
    "serialport": "^13.0.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
